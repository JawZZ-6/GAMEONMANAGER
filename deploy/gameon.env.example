# Copy to /etc/gameon.env, then: chmod 600 /etc/gameon.env
HOST=127.0.0.1
PORT=4310
GAMEON_DATA_DIR=/var/lib/gameon

# Exactly the public address, with https:// and no path. A trailing slash is tolerated.
GAMEON_ORIGIN=https://gameon.example.com

# One reverse proxy (Caddy) sits in front of GameON.
GAMEON_TRUST_PROXY=1

# Used only on the first start, while no organiser password exists (at least 12 characters).
# Remove this line and restart the service once you can sign in.
GAMEON_ADMIN_PASSWORD=
